{
  "manifest_version": 3,
  "name": "Schoology Companion",
  "description": "A private, accessible workspace for organizing Schoology.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "assets/background.js"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Schoology Companion"
  },
  "content_scripts": [
    {
      "matches": ["https://*.schoology.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["assets/styles.css"],
      "matches": ["https://*.schoology.com/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
